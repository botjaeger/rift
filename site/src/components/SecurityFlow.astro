---
// A command leaves the phone, crosses the relay as ciphertext and arrives as text: end-to-end
// encryption in one picture. It plays once when scrolled into view (under 5 s); Play again repeats it.
// Without JavaScript, or with reduced motion, it shows the finished state.
---

<figure class="flow" data-flow aria-labelledby="flow-cap">
  <div class="track" aria-hidden="true">
    <span class="pkt"><span class="plain">git status</span><span class="cipher">a9 3f c1 07 5e</span></span>
    <div class="node">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="6" y="2" width="12" height="20" rx="3"></rect><path d="M11 18h2"></path></svg>
      <span>Phone</span>
    </div>
    <div class="wire"></div>
    <div class="node relay">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 12h16"></path><path d="m15 7 5 5-5 5"></path><path d="M9 7 4 12l5 5"></path></svg>
      <span>Relay</span>
      <small>sees only <code>a9 3f c1 07…</code></small>
    </div>
    <div class="wire second"></div>
    <div class="node">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8"></path><path d="M12 16v4"></path></svg>
      <span>Your computer</span>
      <small class="arrived">runs <code>git status</code></small>
    </div>
  </div>
  <figcaption id="flow-cap">
    <span>Encrypted on the phone, decrypted only on your computer: Noise XX with X25519, ChaCha20-Poly1305 and BLAKE2s. The relay holds no key.</span>
    <button type="button" class="again" hidden>Play again</button>
  </figcaption>
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-flow]')) {
    const again = fig.querySelector<HTMLButtonElement>('.again')!;
    const track = fig.querySelector<HTMLElement>('.track')!;
    const pkt = fig.querySelector<HTMLElement>('.pkt')!;
    const [w1, w2] = fig.querySelectorAll<HTMLElement>('.wire');
    // Reduced motion (or no JavaScript): the finished state stays, with no packet and no button.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    // The packet runs from the first wire's start to the second wire's end, wherever the layout put them.
    const place = () => {
      const t = track.getBoundingClientRect();
      const a = w1.getBoundingClientRect();
      const b = w2.getBoundingClientRect();
      pkt.style.setProperty('--x0', `${a.left - t.left}px`);
      pkt.style.setProperty('--x1', `${b.right - t.left - pkt.offsetWidth}px`);
      pkt.style.left = `${a.left - t.left}px`;
      pkt.style.top = `${a.top - t.top - pkt.offsetHeight / 2}px`;
    };
    const play = () => {
      place();
      fig.classList.remove('play');
      void fig.offsetWidth; // restart the animation
      fig.classList.add('play');
    };
    place();
    addEventListener('resize', place);
    fig.classList.add('ready');
    new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) {
        play();
        obs.disconnect();
      }
    }, { threshold: 0.6 }).observe(fig);
    again.hidden = false;
    again.addEventListener('click', play);
  }
</script>

<style>
  .flow { margin: 40px 0 0; padding: 28px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line-card); }
  .track { position: relative; display: grid; grid-template-columns: auto 1fr auto 1fr auto; align-items: start; gap: 0 4px; }
  .node { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; color: var(--text-strong); font-size: 14px; font-weight: 600; min-width: 88px; }
  .node svg { width: 56px; height: 56px; padding: 14px; border-radius: 14px; border: 1px solid #19aad866; background: #19aad814; color: var(--accent); }
  .node.relay svg { border-style: dashed; border-color: #ffffff40; background: transparent; color: var(--text-muted); }
  .node small { font-size: 12px; font-weight: 400; color: var(--text-muted); }
  .node code { font-family: var(--font-mono); font-size: 11px; color: var(--text); }
  .wire { position: relative; height: 1px; margin-top: 28px; background: linear-gradient(90deg, #19aad8, #19aad855); }
  .pkt { position: absolute; top: 15px; left: 0; z-index: 1; display: grid; font-family: var(--font-mono); font-size: 12px; white-space: nowrap; }
  .pkt > span { grid-area: 1 / 1; padding: 3px 8px; border-radius: 6px; }
  .plain { background: var(--accent); color: #050505; font-weight: 600; }
  .cipher { background: #1e1e1e; color: var(--text-muted); border: 1px solid #ffffff26; opacity: 0; }
  figcaption { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; font-size: 14px; line-height: 1.6; color: var(--text-muted); }
  figcaption span { flex: 1 1 420px; }
  .again { min-height: 44px; padding: 0 16px; font: inherit; font-weight: 600; color: var(--text-strong); background: transparent; border: 1px solid #ffffff26; border-radius: 8px; cursor: pointer; }
  .again:hover { border-color: #ffffff59; }

  /* The packet travels over both wires (the second one is the first's continuation, drawn by translating it). */
  .pkt { opacity: 0; }
  .ready .pkt { opacity: 1; }
  .ready .arrived { opacity: 0; }
  .play .pkt { animation: travel 3.6s cubic-bezier(.45, 0, .55, 1) both; }
  .play .plain { animation: toCipher 3.6s linear both; }
  .play .cipher { animation: fromCipher 3.6s linear both; }
  .play .arrived { animation: arrive 3.6s linear both; }
  @keyframes travel {
    0% { left: var(--x0); opacity: 1; }
    92% { left: var(--x1); opacity: 1; }
    100% { left: var(--x1); opacity: 0; }
  }
  @keyframes toCipher { 0%, 18% { opacity: 1; } 26%, 74% { opacity: 0; } 82%, 100% { opacity: 1; } }
  @keyframes fromCipher { 0%, 18% { opacity: 0; } 26%, 74% { opacity: 1; } 82%, 100% { opacity: 0; } }
  @keyframes arrive { 0%, 90% { opacity: 0; } 100% { opacity: 1; } }

  @media (max-width: 640px) {
    .flow { padding: 20px 16px; }
    .node { min-width: 64px; font-size: 13px; }
    .node svg { width: 44px; height: 44px; padding: 10px; }
    .wire { margin-top: 22px; }
    .node small { display: none; }
  }
</style>
