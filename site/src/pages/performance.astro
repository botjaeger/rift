---
import Base from '../layouts/Base.astro';

// Every number here is from the Rift performance baseline (docs/performance.md): macOS 27, Apple M3 Max,
// release build, wall clock. Compare runs on the same machine only.

const hero = [
  { value: '322 ms', label: 'from launch to the first shell prompt', note: '107 MiB peak' },
  { value: '4.34 ms', label: 'from a key press to the frame that shows it (p50)', note: 'p95 8.40 ms' },
  { value: '544 ms', label: 'to print seq 1 500000 as one block', note: '138 MiB peak' },
  { value: '12 ms', label: 'to open another window', note: '+9 MiB each' },
];

// vtebench: median ms to read 1 MiB of each workload, lower is faster (A/B in the same minutes).
const vte = [
  ['scrolling', 63, 36], ['scrolling_bottom_small_region', 52, 34], ['scrolling_top_region', 49, 32],
  ['scrolling_bottom_region', 37, 24], ['scrolling_top_small_region', 34, 24], ['dense_cells', 22, 11],
  ['sync_medium_cells', 19, 16], ['cursor_motion', 18, 11], ['medium_cells', 18, 11],
  ['scrolling_fullscreen', 15, 10], ['light_cells', 13, 9], ['unicode', 9, 9],
] as const;
const vteMax = 63;

// What the first measurements found, and the same scenario after the fix.
const found = [
  { title: 'Half a million lines', before: 4161, after: 544, unit: 'ms', why: 'The shape cache held every trailing blank cell of each row. Rows are now shaped only up to their last visible character; the peak went from 2883 MiB to 138 MiB.' },
  { title: '100k lines of scrollback', before: 442, after: 76, unit: 'MB', why: 'History rows kept every cell of the window’s width. A row entering the history now drops its trailing blanks, and steady scrolling allocates nothing.' },
  { title: 'A second window', before: 322, after: 12, unit: 'ms', noFactor: true, why: '⌘N used to start another process: 322 ms to its prompt and 107 MiB. Windows now share one process, its GPU device, fonts and glyph atlas; opening one holds the UI thread 12 ms and adds 9 MiB.' },
  { title: 'cat a 20 MiB file', before: 320, after: 290, unit: 'ms', why: 'The same scrollback change, measured A/B on the same machine, three runs each.' },
];

// Completion work per keystroke, p95 (first of two runs); the test fails over 5 ms.
const completion = [
  { name: 'Paths: 10 000 files in one folder', before: 27.3, after: 2.02 },
  { name: 'Git refs: 5 000 loose + 20 000 packed', before: 4.92, after: 0.31 },
  { name: 'History: 50 000 shell lines', before: 0.02, after: 0.19 },
  { name: 'Command names on $PATH', before: 0.0, after: 0.25 },
];
const BUDGET = 5;
const compMax = 27.3;

// ucs-detect 2.3.8: share of strings measured as wcwidth does.
const ucs = [
  ['Narrow', 5570, 5595, 5595], ['Wide (East Asian)', 480, 506, 506], ['Languages (scripts, combining)', 5558, 6572, 6589],
  ['Regional indicators (flags)', 262, 262, 262], ['Standalone regional indicators', 0, 26, 26], ['Emoji VS16 (text → emoji)', 213, 426, 426],
  ['Emoji VS15 (emoji → text)', 0, 158, 158], ['Emoji ZWJ sequences', 10, 1445, 1445],
] as const;
const pct = (n: number, d: number) => Math.round((n / d) * 1000) / 10;
const fmt = (n: number) => (n < 1 ? n.toFixed(2) : n % 1 ? n.toFixed(2) : String(n));
---

<Base
  page="performance"
  title="Rift performance: startup, latency, throughput and compatibility"
  description="Measured Rift numbers: 322 ms to the first prompt, 4.34 ms key-to-frame, half a million lines in 544 ms, 12 ms per extra window, vtebench before and after, and 524 of 524 esctest tests passing."
>
  <section class="glow-section">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap relative pf-hero">
      <p class="in eyebrow">Performance</p>
      <h1 class="in d1">Fast where you feel it</h1>
      <p class="in d2 lead">
        Rift renders on the GPU and keeps memory flat while output pours in. Every number below was measured on a release build;
        how, and on what, is at the end.
      </p>
      <dl class="in d3 stats">
        {
          hero.map((s) => (
            <div>
              <dt class="mono">{s.value}</dt>
              <dd>{s.label}<span>{s.note}</span></dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="rule" aria-labelledby="vte-h">
    <div class="wrap section">
      <h2 class="h-section" id="vte-h">Throughput: vtebench</h2>
      <p class="lead narrow">
        Median time to read 1 MiB of each workload, lower is faster. The previous build and this one ran in turns in the same
        minutes. The gain is frame pacing: frames now wait at least 8.3 ms (120 Hz) after the last one instead of running back to
        back and locking the terminal the parser writes into.
      </p>
      <div class="legend" aria-hidden="true"><span><i class="sw before"></i>Before</span><span><i class="sw now"></i>Now</span></div>
      <table class="bars" data-bars>
        <caption class="sr-only">vtebench median milliseconds per workload, before and now</caption>
        <thead class="sr-only"><tr><th scope="col">Benchmark</th><th scope="col">Before</th><th scope="col">Now</th></tr></thead>
        <tbody>
          {
            vte.map(([name, b, n]) => (
              <tr>
                <th scope="row" class="mono">{name}</th>
                <td>
                  <span class="bar before" style={`--f: ${b / vteMax}`} title={`${name}: before ${b} ms`}></span>
                  <span class="val">{b} ms</span>
                </td>
                <td>
                  <span class="bar now" style={`--f: ${n / vteMax}`} title={`${name}: now ${n} ms`}></span>
                  <span class="val strong">{n} ms</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="rule deep" aria-labelledby="found-h">
    <div class="wrap section">
      <h2 class="h-section" id="found-h">What measuring found</h2>
      <p class="lead narrow">The first runs of the benchmark found real costs. Each was fixed and measured again.</p>
      <div class="found" data-bars>
        {
          found.map((f) => (
            <div class="card fcard">
              <h3>{f.title}</h3>
              <div class="pair">
                <div class="prow">
                  <span class="plabel">Before</span>
                  <span class="track"><span class="bar before" style="--w: 100%"></span></span>
                  <span class="val mono">{f.before} {f.unit}</span>
                </div>
                <div class="prow">
                  <span class="plabel">Now</span>
                  <span class="track"><span class="bar now" style={`--w: ${Math.max((f.after / f.before) * 100, 1.5)}%`}></span></span>
                  <span class="val mono strong">{f.after} {f.unit}</span>
                </div>
              </div>
              {!f.noFactor && <p class="factor mono">{f.before / f.after >= 2 ? `${Math.round(f.before / f.after)}× ${f.unit === 'MB' ? 'smaller' : 'faster'}` : `${Math.round((1 - f.after / f.before) * 100)}% ${f.unit === 'MB' ? 'smaller' : 'faster'}`}</p>}
              <p class="why">{f.why}</p>
            </div>
          ))
        }
      </div>
      <p class="note">A window opened, used and closed 22 times: the process stayed at 176 MB over the 10 measured cycles.</p>
    </div>
  </section>

  <section class="rule" aria-labelledby="comp-h">
    <div class="wrap section">
      <h2 class="h-section" id="comp-h">Completions on every keystroke</h2>
      <p class="lead narrow">
        The work the completion thread does per keystroke, slowest 5 % (p95). A test fails the build when any p95 passes 5 ms.
        Paths and git refs now read a cached listing after one check; history and command names gained ranking and fuzzy matching
        and stay far under the budget.
      </p>
      <div class="legend" aria-hidden="true"><span><i class="sw before"></i>Before</span><span><i class="sw now"></i>Now</span><span><i class="sw budget"></i>5 ms budget</span></div>
      <table class="bars comp" data-bars style={`--b: ${BUDGET / compMax}`}>
        <caption class="sr-only">Completion p95 in milliseconds, before and now; budget 5 ms</caption>
        <thead class="sr-only"><tr><th scope="col">Completion</th><th scope="col">Before</th><th scope="col">Now</th></tr></thead>
        <tbody>
          {
            completion.map((c) => (
              <tr>
                <th scope="row">{c.name}</th>
                <td>
                  <span class="bar before" style={`--f: ${c.before / compMax}`}></span>
                  <span class="val">{fmt(c.before)} ms</span>
                </td>
                <td>
                  <span class="bar now" style={`--f: ${c.after / compMax}`}></span>
                  <span class="val strong">{fmt(c.after)} ms</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="rule deep" aria-labelledby="compat-h">
    <div class="wrap section">
      <h2 class="h-section" id="compat-h">Compatibility</h2>
      <p class="lead narrow">Fast only counts if programs draw right. Rift runs the standard terminal test suites.</p>
      <div class="suites">
        <div class="card suite">
          <p class="big mono">524 <span>/ 524</span></p>
          <h3>esctest2</h3>
          <p>Every test passes at VT level 4 against xterm’s expectations, besides the 43 that fail on xterm itself. The first run passed 101.</p>
        </div>
        <div class="card suite">
          <p class="big mono">100 <span>%</span></p>
          <h3>ucs-detect</h3>
          <p>Character widths match wcwidth for narrow, wide, flags, emoji and ZWJ sequences; 99.7 % for languages, 100 % measured alone.</p>
        </div>
        <div class="card suite">
          <p class="big mono">vttest</p>
          <h3>Menus 1–4 and 8</h3>
          <p>Cursor movement, scrolling regions, origin mode, SGR attributes, DEC line drawing, 132-column mode and double-size lines.</p>
        </div>
      </div>

      <h3 class="sub">ucs-detect, before and now</h3>
      <table class="bars ucs" data-bars>
        <caption class="sr-only">ucs-detect: share of strings measured as wcwidth does, before and now</caption>
        <thead class="sr-only"><tr><th scope="col">Category</th><th scope="col">Before</th><th scope="col">Now</th></tr></thead>
        <tbody>
          {
            ucs.map(([name, b, n, d]) => (
              <tr>
                <th scope="row">{name}</th>
                <td>
                  <span class="bar before" style={`--f: ${b / d}`}></span>
                  <span class="val">{pct(b, d)} %</span>
                </td>
                <td>
                  <span class="bar now" style={`--f: ${n / d}`}></span>
                  <span class="val strong">{pct(n, d)} %</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="note">
        Also detected: the kitty keyboard protocol with all five flags, kitty and iTerm2 graphics, styled and coloured underlines,
        DECRQCRA and DECRQSS. Sixel is not implemented.
      </p>
    </div>
  </section>

  <section class="rule" aria-labelledby="how-h">
    <div class="wrap section">
      <h2 class="h-section" id="how-h">How it was measured</h2>
      <p class="lead narrow">
        A benchmark script drives the release build through Rift’s script driver, headless, in a scratch config and data folder,
        and prints one row per scenario. Numbers are wall clock: compare runs on the same machine only.
      </p>
      <dl class="how">
        <div><dt>Machine</dt><dd>macOS 27, Apple M3 Max, release build. Baseline 14 Oct 2026; windows and completions 17 Oct; suites 10 Oct.</dd></div>
        <div><dt>Startup</dt><dd>Process start to the first shell prompt, best of 3.</dd></div>
        <div><dt>Key to frame</dt><dd>From a raw key write to the first presented frame after the program’s echo, 41 keys into <code>cat</code>, in a visible window.</dd></div>
        <div><dt>Throughput</dt><dd>The finished block’s own duration for <code>seq 1 500000</code> and <code>cat</code> of a 20 MiB file.</dd></div>
        <div><dt>Memory</dt><dd>Peak resident memory, including 300k lines into a 100k-line scrollback (169 MiB).</dd></div>
        <div><dt>New window</dt><dd>How long opening it held the UI thread (window, GPU surface, pipelines, first tab), best of 3.</dd></div>
        <div><dt>Loaded machines</dt><dd>Some runs shared the machine with virtual machines; those compare builds A/B in the same minutes.</dd></div>
        <div><dt>Suites</dt><dd><a href="https://github.com/alacritty/vtebench">vtebench</a>, <a href="https://github.com/ThomasDickey/esctest2">esctest2</a>, ucs-detect and vttest, run inside Rift.</dd></div>
      </dl>
    </div>
  </section>
</Base>

<script>
  // Bars grow in once when they scroll into view; without JavaScript (or with reduced motion) they are drawn at full length.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const groups = document.querySelectorAll<HTMLElement>('[data-bars]');
    for (const g of groups) g.classList.add('waiting');
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.remove('waiting');
        io.unobserve(e.target);
      }
    }, { threshold: 0.25 });
    for (const g of groups) io.observe(g);
  }
</script>

<style>
  .pf-hero { padding-top: 96px; padding-bottom: 80px; }
  .pf-hero h1 { margin: 16px 0 0; font-size: clamp(40px, 6vw, 68px); line-height: 1.04; letter-spacing: -0.04em; color: var(--text-strong); }
  .pf-hero .lead { margin-top: 18px; max-width: 680px; font-size: 18px; }
  .stats { margin: 48px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 16px; }
  .stats div { padding: 22px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line-card); }
  .stats dt { font-size: clamp(30px, 3.4vw, 40px); font-weight: 600; color: var(--text-strong); letter-spacing: -0.02em; }
  .stats dd { margin: 8px 0 0; font-size: 14px; line-height: 1.5; color: var(--text-muted); }
  .stats dd span { display: block; margin-top: 6px; font-family: var(--font-mono); font-size: 12px; color: var(--accent); }

  .section { padding-top: 96px; padding-bottom: 96px; }
  .narrow { max-width: 760px; margin-top: 14px; }
  .note { margin: 24px 0 0; max-width: 760px; font-size: 14px; line-height: 1.6; color: var(--text-muted); }
  code { font-family: var(--font-mono); font-size: 0.88em; color: #f1f1f1; background: #ffffff0f; border: 1px solid #ffffff14; border-radius: 4px; padding: 1px 5px; }

  .legend { display: flex; gap: 20px; margin-top: 32px; font-size: 13px; color: var(--text-muted); }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .sw { width: 14px; height: 8px; border-radius: 2px; display: inline-block; }
  .sw.before, .bar.before { background: #6b6b6b; }
  .sw.now, .bar.now { background: var(--accent); }
  .sw.budget { width: 2px; height: 14px; background: #e5a01a; }

  /* Bar tables: a row per item, the two bars stacked in it. */
  .bars { width: 100%; margin-top: 16px; border-collapse: collapse; }
  .bars tr { display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 20px; row-gap: 2px; padding: 8px 0; border-top: 1px solid var(--line-card); }
  .bars th { grid-row: 1 / span 2; align-self: center; text-align: left; font-size: 13px; font-weight: 500; color: var(--text); overflow-wrap: anywhere; }
  .bars td { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 0; }
  /* Bars grow by transform (no layout work); a bar's length is its share of the room beside its value. */
  .bar { display: block; height: 8px; border-radius: 0 4px 4px 0; flex: none; transform-origin: left center; transition: transform .9s cubic-bezier(.2, .8, .2, 1); }
  .bars .bar { width: calc((100% - 70px) * var(--f)); min-width: 2px; }
  .val { flex: none; font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); }
  .val.strong { color: var(--text-strong); }
  .waiting .bar { transform: scaleX(0); }
  /* The 5 ms budget, on the same scale as the bars. */
  .comp td { position: relative; }
  .comp td::after { content: ''; position: absolute; top: -3px; bottom: -3px; left: calc((100% - 70px) * var(--b)); width: 2px; background: #e5a01a99; }

  .found { margin-top: 36px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 16px; }
  .fcard h3 { margin: 0; font-size: 17px; color: var(--text-strong); }
  .pair { display: flex; flex-direction: column; gap: 8px; margin-top: 6px; }
  .prow { display: grid; grid-template-columns: 52px minmax(0, 1fr) auto; gap: 10px; align-items: center; }
  .plabel { font-size: 12px; color: var(--text-muted); }
  .track { display: block; min-width: 0; }
  .track .bar { width: var(--w); }
  .factor { margin: 6px 0 0; font-size: 22px; font-weight: 600; color: var(--accent); }
  .why { margin: 0; font-size: 14px; line-height: 1.6; color: var(--text-muted); }

  .suites { margin-top: 36px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 16px; }
  .suite h3 { margin: 0; font-size: 17px; color: var(--text-strong); }
  .suite p { margin: 0; font-size: 14px; line-height: 1.6; color: var(--text-muted); }
  .suite .big { font-size: 40px; font-weight: 600; color: var(--text-strong); letter-spacing: -0.02em; }
  .big span { font-size: 20px; color: var(--text-muted); }
  .sub { margin: 48px 0 0; font-size: 19px; color: var(--text-strong); }

  .how { margin: 32px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 0 40px; }
  .how div { padding: 14px 0; border-top: 1px solid var(--line-card); }
  .how dt { font-size: 14px; font-weight: 600; color: var(--text-strong); }
  .how dd { margin: 4px 0 0; font-size: 14px; line-height: 1.6; color: var(--text-muted); }
  .how a { text-decoration: underline; text-decoration-color: #19aad866; text-underline-offset: 3px; }

  @media (max-width: 720px) {
    .pf-hero { padding-top: 56px; padding-bottom: 56px; }
    .section { padding-top: 72px; padding-bottom: 72px; }
    .bars tr { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; }
    .bars th { grid-row: auto; margin-bottom: 4px; }
  }
</style>
