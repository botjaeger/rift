---
import Base from '../layouts/Base.astro';
import '../styles/window.css';
import PhonePortals from '../components/PhonePortals.astro';
import { REPO_URL, getRelease, platforms } from '../lib/release';

const release = await getRelease();

const features = [
  {
    title: 'Filter and compare output',
    body: 'Keep only matching lines with text or regex, or diff two runs of the same command line by line.',
    keys: ['⌥⇧F'],
    icon: '<path d="M3 5h18"/><path d="M3 12h12"/><path d="M3 19h8"/>',
  },
  {
    title: 'Code review built in',
    body: 'Staged and unstaged diffs; stage, unstage or revert a hunk, then commit and push without leaving the window.',
    keys: ['⇧⌘G'],
    icon: '<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="8" r="2.5"/><path d="M6 8.5v7"/><path d="M18 10.5c0 4-6 3-11 6"/>',
  },
  {
    title: 'File explorer',
    body: 'The project tree with git status, and a viewer that renders Markdown and runs its shell blocks on request.',
    keys: ['⇧⌘E'],
    icon: '<path d="M3 6h7l2 2h9v11H3z"/>',
  },
  {
    title: 'Tabs, splits, vertical rail',
    body: "Split panes, tab groups and pins, colours by folder, and a searchable side rail with each pane's branch and changes.",
    keys: ['⌘D', '⇧⌘D'],
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M12 4v16"/><path d="M12 12h9"/>',
  },
  {
    title: 'Knows when agents need you',
    body: 'Claude Code and Codex tabs spin only while the agent works; finished and failed commands land in one inbox.',
    keys: ['⇧⌘A'],
    icon: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10 21h4"/>',
  },
  {
    title: "13 themes, or bring Warp's",
    body: 'Your own TOML or Warp YAML themes, gradients included, a theme per pane, and light/dark that follows the OS.',
    keys: ['⌘P'],
    hint: 'Theme picker',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/>',
  },
  {
    title: 'SSH with remote blocks',
    body: 'SSH profiles in the palette; install the shell integration on a host once and its commands become blocks too.',
    keys: ['⌘P'],
    hint: 'SSH: host',
    icon: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8"/><path d="m7 9 2 2-2 2"/>',
  },
  {
    title: 'Shells survive updates',
    body: 'Rift updates itself; tabs and running shells come back after the restart, and after a crash.',
    keys: ['Update Rift'],
    icon: '<path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/>',
  },
];

const protocols = [
  'Kitty keyboard',
  'Kitty graphics',
  'iTerm2 images',
  'OSC 8 links',
  'OSC 52 clipboard',
  'Synchronized output',
  'Bracketed paste',
  'OSC 9 / 777 / 99',
  'VoiceOver · Orca',
];
---

<Base
  page="home"
  title={`Rift: a block-based GPU terminal for ${platforms(release)}`}
  description={`Rift is a GPU-accelerated terminal for ${platforms(release)} that turns every command into a block you can select, copy, search, bookmark, re-run or pipe, with a phone companion app.`}
>
  <!-- Hero -->
  <section id="top" class="glow-section">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="wrap relative hero">
      <a class="in mono pill" href={release.notesUrl}>v{release.version} is out · see what's new →</a>
      <h1 class="in d1">Every command is a block.</h1>
      <p class="in d2 hero-lead">
        A GPU-accelerated terminal for {platforms(release)} that keeps each command, its output, exit status and duration
        together, so you can select, copy, search, bookmark, re-run or pipe it in one keystroke.
      </p>
      <div class="in d3 actions">
        <a class="btn btn-primary" href="/download/">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12"></path><path d="m6 11 6 6 6-6"></path><path d="M5 20h14"></path></svg>
          Download for macOS
        </a>
        <a class="btn btn-ghost" href="/download/#linux">Linux packages</a>
        {release.windows && <a class="btn btn-ghost" href="/download/#windows">Windows (beta)</a>}
      </div>
      <p class="in d4 fine">No account · no telemetry · configured with one TOML file</p>
    </div>

    <!-- Product window -->
    <div class="relative window-wrap">
      <figure class="window" aria-label="Rift window with three command blocks and the command editor">
        <div class="titlebar">
          <div class="lights" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="mono tabs">
            <span class="tab active"><span class="dot"></span>project1</span>
            <span class="tab hide-sm">project2</span>
            <span class="tab hide-sm">claude</span>
          </div>
          <span class="mono hide-sm palette-hint">⌘P palette</span>
        </div>
        <div class="mono term">
          <div class="blk b1">
            <div class="bh"><span class="cmd">git status --short</span><span class="dir">~/code/project1</span><span class="branch">main</span><span class="meta"><span class="badge ok">✓ 0</span><span class="dur">14ms</span></span></div>
            <div class="out"><span class="red">&nbsp;M</span> src/server.ts<br /><span class="lime">??</span> notes.md</div>
          </div>
          <div class="blk b2 selected">
            <div class="bh"><span class="cmd"><span class="acc">pnpm</span> test <span class="flag">--run</span></span><span class="dir">~/code/project1</span><span class="branch">main</span><span class="meta"><span class="badge ok">✓ 0</span><span class="dur">4.2s</span></span></div>
            <div class="out pre">{' Test Files  '}<span class="lime">18 passed</span> (18)<br />{'      Tests  '}<span class="lime">214 passed</span> (214)</div>
          </div>
          <div class="blk b3 failed">
            <div class="bh"><span class="cmd"><span class="acc">cargo</span> build <span class="flag">--release</span></span><span class="dir">~/code/project2</span><span class="branch">main</span><span class="meta"><span class="badge err">✕ 101</span><span class="dur">38.1s</span></span></div>
            <div class="out"><span class="red bold">error[E0425]</span>: cannot find value `cfg` in this scope<br /><span class="flag">&nbsp;&nbsp;--&gt;</span> src/main.rs:42:9</div>
          </div>
          <div class="blk b4 prompt">
            <div class="ctx"><span class="acc">~/code/project1</span> on <span class="branch">main</span></div>
            <div class="line"><span class="branch">❯</span> <span class="acc">git</span> commit <span class="flag">-m</span> <span class="str">"fix: </span><span class="caret" aria-hidden="true"></span><span class="ghost">retry the upload once"</span></div>
          </div>
        </div>
      </figure>
      <p class="window-note">
        The selected block: <span class="kbd">⌥⇧⌘C</span> copies only its output; <span class="kbd">⌘↑</span>
        <span class="kbd">⌘↓</span> move between blocks.
      </p>
    </div>
  </section>

  <!-- Three reasons -->
  <section class="rule">
    <div class="wrap reasons">
      <div class="reveal reason">
        <h2>Output has structure</h2>
        <p>Rift knows where each command starts and ends. Copying the output of a failed build, or jumping to the last error, is one keystroke instead of a scroll hunt.</p>
      </div>
      <div class="reveal reason">
        <h2>The command line is an editor</h2>
        <p>Syntax highlighting, completions with descriptions, multi-line editing, several carets, undo and optional vim keys, before the shell sees anything.</p>
      </div>
      <div class="reveal reason">
        <h2>A full terminal underneath</h2>
        <p>vim, tmux, htop, ssh and every TUI run unchanged. When a program is running, Rift hands it the keyboard.</p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="rule">
    <div class="wrap section stack-44">
      <div class="reveal intro">
        <p class="eyebrow">Features</p>
        <h2 class="h-section">Built for the work you do in a terminal all day</h2>
        <p class="lead">Every action is in the command palette and can be rebound. <a href="/features/">See all features →</a></p>
      </div>
      <div class="feature-grid">
        {
          features.map((f) => (
            <div class="card reveal">
              <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="ficon" set:html={f.icon} />
              <h3>{f.title}</h3>
              <p class="fbody">{f.body}</p>
              <p class="fkeys">
                {f.keys.map((k) => <span class="kbd">{k}</span>)}
                {f.hint && <span class="hint">{f.hint}</span>}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Phone -->
  <section id="phone" class="rule deep">
    <div class="wrap section phone-row">
      <div class="reveal phone-copy">
        <p class="eyebrow">Phone companion</p>
        <h2 class="h-section">Your terminal, away from your desk</h2>
        <p class="lead">Pair an iPhone or Android phone with a QR code. Follow panes live, answer an agent, run a command or send Ctrl-C from anywhere.</p>
        <ul class="checks">
          <li><span aria-hidden="true">✓</span>End-to-end encrypted (Noise), paired by QR</li>
          <li><span aria-hidden="true">✓</span>Directly on your network, or through a relay that only sees ciphertext</li>
          <li><span aria-hidden="true">✓</span>Run your own relay if you prefer</li>
        </ul>
        <div class="store-links">
          <a class="btn btn-ghost placeholder" href="#phone">[APP STORE LINK]</a>
          <a class="btn btn-ghost placeholder" href="#phone">[GOOGLE PLAY LINK]</a>
        </div>
        <p class="phone-more"><a href="/phone/">How pairing, the relay and security work →</a></p>
      </div>
      <div class="reveal phone-wrap">
        <PhonePortals />
      </div>
    </div>
  </section>

  <!-- Performance and protocols -->
  <section id="speed" class="rule">
    <div class="wrap section stack-56">
      <dl class="stats">
        <div><dt class="mono">0.54 s</dt><dd>to render 500,000 lines of output</dd></div>
        <div><dt class="mono">138 MiB</dt><dd>peak memory for that run</dd></div>
        <div><dt class="mono">1 binary</dt><dd>fonts, themes and shell hooks embedded</dd></div>
      </dl>
      <p class="speed-more"><a href="/performance/">Full numbers: latency, throughput and test suites →</a></p>
      <div class="two-col">
        <div class="reveal col" style="flex-basis: 360px">
          <h2>Warp's habits, without the account</h2>
          <p>Warp's default keys, themes and launch configurations work unchanged. Profiles, actions and kept exited panes work as in Windows Terminal. Settings live in one file and apply as you save.</p>
          <p class="mono path">~/.config/rift/config.toml</p>
        </div>
        <div class="reveal col" style="flex-basis: 420px">
          <h2>Modern protocols</h2>
          <ul class="mono chips">
            {protocols.map((p) => <li class="chip">{p}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="glow-section rule">
    <div class="cta-bg" aria-hidden="true"></div>
    <div class="wrap relative cta">
      <img class="reveal" src="/rift-144.png" alt="Rift logo" width="72" height="72" loading="lazy" />
      <h2 class="reveal">Type a command. It becomes a block.</h2>
      <div class="reveal actions">
        <a class="btn btn-primary" href="/download/">Download Rift</a>
        <a class="btn btn-ghost" href={REPO_URL}>View on GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 112px; padding-bottom: 64px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .pill { font-size: 13px; color: #b4b4b4; border: 1px solid #ffffff1f; border-radius: 999px; padding: 12px 16px; line-height: 1.3; }
  .pill:hover { color: var(--text-strong); border-color: #ffffff40; }
  .hero h1 { margin: 0; font-size: clamp(42px, 6.4vw, 76px); line-height: 1.04; letter-spacing: -0.035em; font-weight: 700; color: var(--text-strong); max-width: 880px; }
  .hero-lead { margin: 0; font-size: clamp(17px, 1.8vw, 20px); line-height: 1.55; color: var(--text-muted); max-width: 620px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 6px; }
  .fine { margin: 0; font-size: 13px; color: var(--text-faint); }

  .window-wrap { max-width: 1080px; margin: 0 auto; padding: 0 var(--gutter) 112px; }
  /* The drawn window itself lives in src/styles/window.css; only its entrance is the hero's. */
  .window { animation: rise .9s cubic-bezier(.2, .8, .2, 1) .35s both; }
  .window .blk { animation: fade .4s ease-out both; }
  .b1 { animation-delay: .9s; } .b2 { animation-delay: 1.1s; } .b3 { animation-delay: 1.3s; } .b4 { animation-delay: 1.5s; }
  .window-note { margin: 20px 0 0; text-align: center; font-size: 14px; color: var(--text-faint); line-height: 1.8; }

  .reasons { padding-top: 96px; padding-bottom: 96px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 40px 56px; }
  .reason { display: flex; flex-direction: column; gap: 10px; }
  .reason h2 { margin: 0; font-size: 22px; font-weight: 600; color: var(--text-strong); letter-spacing: -0.015em; }
  .reason p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--text-muted); }

  .section { padding-top: 104px; padding-bottom: 104px; }
  .stack-44 { display: flex; flex-direction: column; gap: 44px; }
  .stack-56 { display: flex; flex-direction: column; gap: 56px; }
  .intro { display: flex; flex-direction: column; gap: 12px; max-width: 680px; }
  .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 14px; }
  .ficon { color: var(--accent); }
  .card h3 { margin: 4px 0 0; font-size: 16px; font-weight: 600; color: var(--text-strong); }
  .fbody { margin: 0; font-size: 14px; line-height: 1.55; color: var(--text-muted); }
  .fkeys { margin: auto 0 0; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .hint { font-size: 13px; color: var(--text-faint); }

  .phone-row { display: flex; flex-wrap: wrap; align-items: center; gap: 64px; }
  .phone-copy { flex: 1 1 420px; display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .phone-copy .lead { line-height: 1.6; }
  .checks { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 15px; line-height: 1.5; color: var(--text); }
  .checks li { display: flex; gap: 12px; align-items: baseline; }
  .checks span { color: var(--accent); }
  .store-links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }
  .phone-more, .speed-more { margin: 0; font-size: 15px; }
  .speed-more { margin-top: -24px; }
  .phone-more a, .speed-more a { display: inline-block; padding: 10px 0; }
  .phone-wrap { flex: 0 1 300px; display: flex; justify-content: center; margin: 0 auto; }

  .stats {
    margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 1px;
    background: var(--line-card); border: 1px solid var(--line-card); border-radius: 12px; overflow: hidden;
  }
  .stats > div { padding: 32px; display: flex; flex-direction: column; gap: 6px; background: var(--bg); }
  .stats dt { font-size: clamp(32px, 4.2vw, 40px); white-space: nowrap; color: var(--text-strong); font-weight: 600; letter-spacing: -0.03em; }
  .stats dd { margin: 0; font-size: 14px; color: var(--text-muted); }
  .two-col { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; }
  .col { flex-grow: 1; flex-shrink: 1; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .col h2 { margin: 0; font-size: 26px; font-weight: 600; letter-spacing: -0.02em; color: var(--text-strong); }
  .col p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--text-muted); }
  .col .path { font-size: 13px; color: var(--text-faint); }
  .chips { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; }
  .chip { border: 1px solid #ffffff1f; border-radius: 6px; padding: 6px 10px; color: #b4b4b4; }

  .cta-bg { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 50% 70% at 50% 100%, #19aad814, transparent 70%); }
  .cta { padding-top: 120px; padding-bottom: 120px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .cta h2 { margin: 0; font-size: clamp(30px, 4.6vw, 48px); letter-spacing: -0.03em; line-height: 1.1; font-weight: 700; color: var(--text-strong); }

  @media (max-width: 720px) {
    .hero { padding-top: 72px; }
    .section { padding-top: 80px; padding-bottom: 80px; }
    .reasons { padding-top: 72px; padding-bottom: 72px; }
    .cta { padding-top: 88px; padding-bottom: 88px; }
    .phone-row { gap: 48px; }
    .phone-copy { flex-basis: 100%; }
  }
</style>
