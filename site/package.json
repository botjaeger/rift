{
  "name": "rift-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "build": "node scripts/sync-docs.mjs && astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "check": "node scripts/sync-docs.mjs && astro check",
    "icons": "node scripts/icons.mjs",
    "docs:sync": "node scripts/sync-docs.mjs",
    "test": "node --test \"scripts/*.test.mjs\""
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "dependencies": {
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
