{
  "expo": {
    "name": "Rift",
    "slug": "rift-mobile",
    "scheme": [
      "rift",
      "rift-remote"
    ],
    "version": "0.4.1",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "dev.botjaeger.rift",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Rift connects to the Rift gateway on your computer over the local network to show your terminal sessions."
      }
    },
    "android": {
      "package": "dev.botjaeger.rift",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#232326"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rift sends the photo or screenshot you pick to the program on your computer.",
          "cameraPermission": "Rift uses the camera to scan the pairing code on your computer's screen, and to take a photo you send to the program.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Rift uses the camera to scan the pairing code on your computer's screen, and to take a photo you send to the program.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/JetBrainsMono-Regular.ttf",
            "./assets/fonts/JetBrainsMono-Medium.ttf",
            "./assets/fonts/JetBrainsMono-Bold.ttf"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Rift uses Face ID to unlock the app and to confirm commands before they run on your computer."
        }
      ],
      "./plugins/withSceneLifecycle",
      "./plugins/withoutApns",
      "./plugins/withLiveActivity",
      "./plugins/withGradleMemory",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-blank.png",
          "imageWidth": 1
        }
      ]
    ],
    "extra": {
      "router": {}
    }
  }
}
