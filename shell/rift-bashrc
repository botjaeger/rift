# shellcheck shell=bash disable=SC1090,SC1091  # sources user/system rc files by design
# Rift bash shim (passed as `bash --rcfile`): replay bash's own startup
# order for this platform, then layer the Rift integration on top.
if [[ "$(uname -s)" == "Darwin" ]]; then
    # macOS terminals run login shells: /etc/profile + the first profile file
    [[ -f /etc/profile ]] && source /etc/profile
    for _rift_f in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
        if [[ -f "$_rift_f" ]]; then
            source "$_rift_f"
            break
        fi
    done
    unset _rift_f
else
    # Linux terminals run interactive non-login shells: system + user rc
    [[ -f /etc/bash.bashrc ]] && source /etc/bash.bashrc
    [[ -f "$HOME/.bashrc" ]] && source "$HOME/.bashrc"
fi
[[ -f "$RIFT_INTEGRATION_BASH" ]] && source "$RIFT_INTEGRATION_BASH"
